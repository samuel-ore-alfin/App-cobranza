# ============================================================================
# bot_cobranza_v2 — variables de entorno
# Copia este archivo a  .env  y completa los valores reales.
# NUNCA subas el .env a git ni lo compartas por chat/correo.
# ============================================================================

# --- Servidor -------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Si el backend corre detras de un reverse proxy corporativo (nginx / Traefik
# / F5), pon aqui la cantidad de proxies para que Express confie en el
# X-Forwarded-For y la auditoria registre la IP real del celular. 0 = sin proxy.
TRUST_PROXY_HOPS=1
# Origen(es) permitido(s) para CORS, separados por coma. Debe ser el dominio
# exacto desde el que se sirve la PWA. Si la PWA la sirve este mismo backend
# (recomendado), dejalo vacio y no se habilita CORS.
CORS_ORIGINS=

# --- SQL Server (SOLO LECTURA — cuenta con permiso unicamente SELECT sobre la vista) ---
# Direccion real (tomada de la credencial n8n SQL_BDRIESGOS_BI_PROD): la
# instancia PROD escucha directo en el 1433, sin nombre de instancia -> dejar
# SQLSERVER_INSTANCE vacio.
SQLSERVER_HOST=10.165.42.10
SQLSERVER_INSTANCE=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=BI
SQLSERVER_USER=app_bot_cobranza
SQLSERVER_PASSWORD=
# Nombre completo de la VISTA de solo lectura (NO la tabla base).
SQLSERVER_VIEW=dbo.VW_BOT_COBRANZA_CAMPO
# TLS hacia SQL Server. true si el server tiene certificado valido.
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERT=true
SQLSERVER_CONNECT_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=15000

# --- Supabase (agentes / sesiones / auditoria) --------------------------
# Se accede por API REST (PostgREST), no por conexion directa a Postgres:
# el firewall del banco bloquea 5432/6543 desde la red interna (ver README v1).
# Se REUTILIZA el mismo proyecto Supabase y las tablas de la v1 (bot de
# WhatsApp, dado de baja): usuarios_autorizados, sesiones, auditoria, en el
# esquema public. Ver db/02_supabase_schema_v2.sql (migracion aditiva).
SUPABASE_URL=https://iboxhzhdknwlmcqxvcmw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# --- Autenticacion -----------------------------------------------------
# Codigo de activacion que el agente debe ingresar la PRIMERA vez para
# definir su PIN. Se lo comunicas en persona durante el onboarding y lo
# rotas cada cierto tiempo. Sin esto, cualquiera que sepa el numero de un
# agente aun-no-activado podria fijarle el PIN.
AGENTE_ACTIVATION_CODE=
# Duracion de la sesion por inactividad (ventana deslizante). 60 min.
SESSION_TTL_MINUTES=60
# Bloqueo de cuenta.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Coste de bcrypt para el hash del PIN.
BCRYPT_ROUNDS=12

# --- Rate limiting del endpoint de busqueda ---------------------------
SEARCH_RATE_PER_MINUTE=10
SEARCH_RATE_PER_DAY=300
SEARCH_RATE_GLOBAL_PER_DAY=5000
# Umbral de alerta de anomalia: consultas por agente en 60 min.
SEARCH_ANOMALY_PER_HOUR=60

# --- Rate limiting del endpoint de login ----------------------------
LOGIN_RATE_PER_MINUTE=10
