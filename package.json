{
  "name": "bot-cobranza-v2",
  "version": "2.0.0",
  "private": true,
  "description": "App interna de consulta de clientes por DNI para agentes de cobranza de campo (Alfin Banco). Login numero + PIN, datos desde SQL Server (solo lectura via vista), auditoria en Supabase.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "setup:view": "node scripts/setup-sqlserver-view.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "mssql": "^11.0.1",
    "morgan": "^1.10.0"
  }
}